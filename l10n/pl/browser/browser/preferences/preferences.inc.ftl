sentinel-swap-settings = Przełącz wygląd ustawień
    .title = Przełącz wygląd ustawień
sentinel-etp =
    .label = Ulepszona ochrona przed śledzeniem
    .description = Sentinel obsługuje — i włącza domyślnie — ulepszoną ochronę przed śledzeniem (Enhanced Tracking Protection) w trybie restrykcyjnym (Strict). Jest to jedno z najważniejszych ustawień w przeglądarce, ponieważ umożliwia rozdzielanie stanu, restrykcyjne listy blokowania i różne przydatne dla prywatności funkcjonalności. Nie zalecamy włączania innych trybów.
permissions-canvas2 =
    .label = Wyodrębnianie płócien
sentinel-is-default-browser-2 =
    .message = { -brand-short-name } jest ustawiony jako Twoja domyślna przeglądarka.
sentinel-is-not-default-browser-2 =
    .message = { -brand-short-name } nie jest ustawiony jako Twoja domyślna przeglądarka.
sentinel-h264 =
